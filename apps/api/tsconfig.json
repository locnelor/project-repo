{
  "compilerOptions": {
    "incremental": true,
    "target": "ES2023",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": "./",
    "module": "commonjs",
    "paths": {
      "@app/api-kit": [
        "libs/api-kit/src"
      ],
      "@app/api-kit/*": [
        "libs/api-kit/src/*"
      ],
      "@app/auth-power": [
        "libs/auth-power/src"
      ],
      "@app/auth-power/*": [
        "libs/auth-power/src/*"
      ],
      "@app/error": [
        "libs/error/src"
      ],
      "@app/error/*": [
        "libs/error/src/*"
      ],
      "@app/file": [
        "libs/file/src"
      ],
      "@app/file/*": [
        "libs/file/src/*"
      ],
      "@app/hash": [
        "libs/hash/src"
      ],
      "@app/hash/*": [
        "libs/hash/src/*"
      ],
      "@app/prisma": [
        "libs/prisma/src"
      ],
      "@app/prisma/*": [
        "libs/prisma/src/*"
      ],
      "@app/redis-cache": [
        "libs/redis-cache/src"
      ],
      "@app/redis-cache/*": [
        "libs/redis-cache/src/*"
      ],
      "@app/website": [
        "libs/website/src"
      ],
      "@app/website/*": [
        "libs/website/src/*"
      ]
    },
    "strictBindCallApply": false,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false,
    "declaration": true,
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
