/// 文件表
model SysFile {
  /// ID
  id         BigInt    @id @default(autoincrement())
  /// 创建人
  createUser BigInt    @map("create_user")
  /// 创建时间
  createTime DateTime  @map("create_time")
  /// 修改人
  updateUser BigInt?   @map("update_user")
  /// 修改时间
  updateTime DateTime? @map("update_time")
  /// 是否已删除（0：否；id：是）
  deleted    BigInt    @default(0)

  /// 名称
  name              String  @db.VarChar(255)
  /// 原始名称
  originalName      String  @map("original_name") @db.VarChar(255)
  /// 大小（字节）
  size              BigInt?
  /// 上级目录
  parentPath        String  @default("/") @map("parent_path") @db.VarChar(512)
  /// 路径
  path              String  @db.VarChar(512)
  /// 扩展名
  extension         String? @db.VarChar(32)
  /// 内容类型
  contentType       String? @map("content_type") @db.VarChar(255)
  /// 类型（0: 目录；1：其他；2：图片；3：文档；4：视频；5：音频）
  type              Int     @default(1) @db.TinyInt
  /// SHA256值
  sha256            String? @db.VarChar(256)
  /// 元数据
  metadata          String? @db.Text
  /// 缩略图名称
  thumbnailName     String? @map("thumbnail_name") @db.VarChar(255)
  /// 缩略图大小（字节)
  thumbnailSize     BigInt? @map("thumbnail_size")
  /// 缩略图元数据
  thumbnailMetadata String? @map("thumbnail_metadata") @db.Text
  /// 存储ID
  storageId         BigInt  @map("storage_id")

  storage SysStorage @relation(fields: [storageId], references: [id])

  @@index([type], map: "idx_type")
  @@index([sha256], map: "idx_sha256")
  @@index([storageId], map: "idx_storage_id")
  @@index([createUser], map: "idx_create_user")
  @@index([updateUser], map: "idx_update_user")
  @@index([deleted], map: "idx_deleted")
  @@map("sys_file")
}
