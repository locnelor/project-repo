/// 公告表
model SysNotice {
  /// ID
  id            BigInt    @id @default(autoincrement())
  /// 标题
  title         String    @db.VarChar(150)
  /// 内容
  content       String    @db.MediumText
  /// 分类
  type          String    @db.VarChar(30)
  /// 通知范围（1：所有人；2：指定用户）
  noticeScope   Int       @default(1) @map("notice_scope") @db.TinyInt
  /// 通知用户
  noticeUsers   Json?     @map("notice_users")
  /// 通知方式（1：系统消息；2：登录弹窗）
  noticeMethods Json?     @map("notice_methods")
  /// 是否定时
  isTiming      Boolean   @default(false) @map("is_timing")
  /// 发布时间
  publishTime   DateTime? @map("publish_time")
  /// 是否置顶
  isTop         Boolean   @default(false) @map("is_top")
  /// 状态（1：草稿；2：待发布；3：已发布）
  status        Int       @default(1) @db.TinyInt
  /// 创建人
  createUser    BigInt    @map("create_user")
  /// 创建时间
  createTime    DateTime  @map("create_time")
  /// 修改人
  updateUser    BigInt?   @map("update_user")
  /// 修改时间
  updateTime    DateTime? @map("update_time")
  /// 是否已删除（0：否；id：是）
  deleted       BigInt    @default(0)

  logs SysNoticeLog[]

  @@map("sys_notice")
  @@index([createUser], map: "idx_create_user")
  @@index([updateUser], map: "idx_update_user")
  @@index([deleted], map: "idx_deleted")
}

/// 公告日志表
model SysNoticeLog {
  /// 公告ID
  noticeId BigInt    @map("notice_id")
  /// 用户ID
  userId   BigInt    @map("user_id")
  /// 读取时间
  readTime DateTime? @map("read_time")

  notice SysNotice @relation(fields: [noticeId], references: [id])
  user   SysUser   @relation(fields: [userId], references: [id])

  @@id([noticeId, userId])
  @@map("sys_notice_log")
}
