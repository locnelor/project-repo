/// 用户表
model sys_user {
  id          String   @id @default(uuid())
  create_time DateTime @default(now())
  update_time DateTime @default(now()) @updatedAt
  create_by   String?
  update_by   String?
  deleted     Boolean  @default(false)

  /// 用户名
  username String @unique

  /// 密码
  password String?

  /// 昵称
  nickname String?

  /// 真实姓名
  real_name String?

  /// 邮箱
  email String?

  /// 手机号
  phone String?

  /// 工号
  job_no String?

  logs         sys_log[]
  dept         sys_dept?       @relation(fields: [dept_id], references: [id])
  dept_id      String?
  sysRoleUsers sys_role_user[]

  @@index([dept_id])
  @@index([username, deleted])
}
