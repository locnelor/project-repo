// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // provider = "postgresql"
  provider     = "mysql"
  // provider     = "sqlite"
  relationMode = "prisma"
}

/// 用户表
model sys_user {
  id          String   @id @default(uuid())
  create_time DateTime @default(now())
  update_time DateTime @default(now()) @updatedAt
  create_by   String?
  update_by   String?
  deleted     Boolean  @default(false)

  /// 用户名
  username String @unique

  /// 密码
  password String?

  /// 昵称
  nickname String?

  /// 真实姓名
  real_name String?

  /// 邮箱
  email String?

  /// 手机号
  phone String?

  /// 工号
  job_no String?

  logs         sys_log[]
  dept         sys_dept?       @relation(fields: [dept_id], references: [id])
  dept_id      String?
  sysRoleUsers sys_role_user[]
}

/// 日志类型
enum log_type {
  INFO // 信息
  WARN // 警告
  ERROR // 错误
}

/// 日志表
model sys_log {
  id          String   @id @default(uuid())
  create_time DateTime @default(now())

  /// 请求唯一码
  request_unique String? @db.VarChar(32)

  /// 日志描述
  description String? @db.VarChar(255)

  /// 日志类型
  log_type log_type?

  /// 请求方法
  method String? @db.VarChar(255)

  /// 请求参数
  params String? @db.Text

  /// 请求IP
  request_ip String? @db.VarChar(255)

  /// 耗时
  time BigInt?

  /// 用户ID
  user_id String? @db.VarChar(32)

  /// 用户名称
  user_name String? @db.VarChar(50)

  /// 地址
  address String? @db.VarChar(255)

  /// 异常信息
  exception_detail String? @db.Text

  user sys_user? @relation(fields: [user_id], references: [id]) /// 用户

  @@index([user_id])
}

/// 部门表
model sys_dept {
  id          String   @id @default(uuid())
  create_time DateTime @default(now())
  update_time DateTime @default(now()) @updatedAt
  create_by   String?
  update_by   String?
  deleted     Boolean  @default(false)

  /// PID
  pid String? @db.VarChar(32)

  /// 部门名称
  name String @db.VarChar(255)

  /// 是否显示
  display Boolean @default(true)

  /// 排序
  sort Int @default(10)

  // 自引用关系
  parent   sys_dept?  @relation("DeptParent", fields: [pid], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children sys_dept[] @relation("DeptParent")

  /// 用户
  users sys_user[]
}

// 系统角色表
model sys_role {
  id          String    @id @db.Char(32)
  create_time DateTime?
  update_time DateTime?
  create_by   String?   @db.VarChar(32)
  update_by   String?   @db.VarChar(32)
  deleted     Boolean   @default(false)

  /// 角色名称
  name String? @db.VarChar(100)

  /// 角色描述
  description String? @db.VarChar(200)

  /// 角色菜单关联
  menus sys_role_menu[]

  /// 角色用户关联
  users sys_role_user[]
}

// 系统菜单表 - 用于前端菜单和权限管理
model sys_menu {
  id          String   @id @default(uuid())
  create_time DateTime @default(now())
  update_time DateTime @default(now()) @updatedAt
  create_by   String?
  update_by   String?
  deleted     Boolean  @default(false)

  /// 父菜单ID
  pid String?

  parent   sys_menu?  @relation("SysMenuParent", fields: [pid], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children sys_menu[] @relation("SysMenuParent")

  /// 菜单名称
  name String?

  /// 菜单URL
  url String?

  /// 授权（多个用逗号分隔，如： user:list,user:create
  perms String?

  /// 类型 0:目录 1:菜单 2:按钮
  type Int @default(0)

  /// 模式：pc，app
  mode String?

  /// 菜单图标
  icon String?

  /// 颜色
  color String?

  /// 路由地址
  routeUrl String?

  /// 是否显示面包屑
  breadCrumb String?

  /// 组件路径
  componentName String?

  /// 组件名称
  componentPath String?

  /// 排序
  orderNum Int @default(0)

  /// 是否显示
  display Boolean @default(true)

  /// 菜单角色关联
  role_menus sys_role_menu[]

  @@index([pid])
}

// 系统角色绑定菜单表
model sys_role_menu {
  id          String    @id @db.Char(32)
  create_by   String?   @db.VarChar(32)
  create_time DateTime?
  deleted     Boolean   @default(false)

  role_id String? @db.VarChar(32) /// 角色id
  menu_id String? @db.VarChar(32) /// 菜单id

  // 关联关系
  role sys_role? @relation(fields: [role_id], references: [id])
  menu sys_menu? @relation(fields: [menu_id], references: [id])

  @@index([role_id])
  @@index([menu_id])
}

// 系统角色绑定用户表
model sys_role_user {
  id          String    @id @db.Char(32)
  create_by   String?   @db.VarChar(32)
  create_time DateTime?
  deleted     Boolean   @default(false)

  /// 角色id
  role_id String? @db.VarChar(32)

  /// 用户id
  user_id String?   @db.VarChar(32)
  role    sys_role? @relation(fields: [role_id], references: [id])
  user    sys_user? @relation(fields: [user_id], references: [id])

  @@index([role_id])
  @@index([user_id])
  @@map("sys_role_user")
}

// 系统附件表
model sys_file {
  id          String    @id @db.VarChar(32)
  create_by   String?   @default("") @db.VarChar(32)
  create_time DateTime?

  /// 文件名称
  name String @default("") @db.VarChar(128)

  /// 文件存放路径
  path String @default("") @db.VarChar(255)

  /// 文件md5
  md5 String @default("") @db.VarChar(32)

  @@index([md5])
}
