{
  "name": "project-repo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo-run dev",
    "lint": "turbo-run lint",
    "generate": "turbo run generate",
    "clean": "node ./scripts/clean.mjs",
    "postinstall": "pnpm -r run stub --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "lint:fix": "eslint . --fix"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/effects/*",
    "internal/*",
    "scripts/*"
  ],
  "dependencies": {
    "unbuild": "^3.6.1",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@internal/tsconfig": "workspace:*",
    "@scripts/turbo-run": "workspace:*",
    "@types/node": "^24.10.4",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "eslint-plugin-format": "^1.1.0",
    "prettier": "^3.7.4",
    "turbo": "^2.7.1",
    "typescript": "5.9.2"
  }
}
