{
  "name": "project-repo",
  "private": true,
  "scripts": {
    "build": "turbo-run build",
    "dev": "turbo-run dev",
    "lint": "turbo-run lint",
    "clean": "node ./scripts/clean.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "postinstall": "pnpm -r run stub --if-present"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@scripts/turbo-run": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "typescript": "5.9.2",
    "@types/node": "^24.10.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/effects/*",
    "internal/*",
    "scripts/*",
    "docs"
  ],
  "dependencies": {
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tailwindcss": "3.4.18",
    "unbuild": "^3.6.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  }
}