{
  "name": "project-repo",
  "private": true,
  "scripts": {
    "build": "turbo-run build",
    "dev": "turbo-run dev",
    "lint": "turbo-run lint",
    "generate": "turbo run generate",
    "clean": "node ./scripts/clean.mjs",
    "postinstall": "pnpm -r run stub --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@internal/tsconfig": "workspace:*",
    "@scripts/turbo-run": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.6.1",
    "dotenv": "^17.2.3",
    "typescript": "5.9.2",
    "@types/node": "^24.10.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/effects/*",
    "internal/*",
    "scripts/*",
    "docs"
  ],
  "dependencies": {
    "tailwindcss": "3.4.18",
    "unbuild": "^3.6.1"
  }
}